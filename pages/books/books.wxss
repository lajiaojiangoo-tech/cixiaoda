/* ===== 单词书列表页 ===== */

.page-container {
  padding: 0 40rpx;
}

/* ---------- 搜索框 ---------- */
.search-bar {
  display: flex;
  align-items: center;
  background: var(--card-bg);
  border-radius: var(--radius-lg);
  padding: 0 24rpx;
  height: 72rpx;
  margin: 20rpx 0 24rpx;
  border: 2rpx solid var(--gray-200);
  transition: border-color 0.2s ease, box-shadow 0.2s ease;
}
.search-bar:focus-within {
  border-color: var(--primary);
  box-shadow: 0 0 0 4rpx rgba(74, 144, 226, 0.12);
}
.search-icon {
  font-size: 28rpx;
  margin-right: 12rpx;
  flex-shrink: 0;
}
.search-icon-css {
  width: 28rpx;
  height: 28rpx;
  border: 4rpx solid var(--gray-400);
  border-radius: 50%;
  position: relative;
  flex-shrink: 0;
  margin-right: 12rpx;
  box-sizing: border-box;
}
.search-icon-css::after {
  content: '';
  position: absolute;
  bottom: -8rpx;
  right: -6rpx;
  width: 6rpx;
  height: 12rpx;
  background: var(--gray-400);
  border-radius: 2rpx;
  transform: rotate(-45deg);
}
.search-input {
  flex: 1;
  height: 100%;
  font-size: 28rpx;
  color: var(--text-primary);
}
.search-clear {
  font-size: 28rpx;
  color: var(--text-placeholder);
  padding: 8rpx;
  flex-shrink: 0;
}

/* ---------- 加载中（转圈圈） ---------- */
.loading-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-top: 400rpx;
}
.spinner {
  width: 80rpx;
  height: 80rpx;
  border: 6rpx solid #E8EBF0;
  border-top-color: var(--primary);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}
@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}
.loading-text {
  font-size: 28rpx;
  color: var(--text-secondary);
  margin-top: 24rpx;
}

/* ---------- 空状态（覆盖全局） ---------- */
.empty-state {
  padding-top: 160rpx;
  justify-content: center;
}

/* ---------- 单词书卡片 ---------- */
.book-card {
  display: flex;
  background: var(--card-bg);
  border-radius: var(--radius-card);
  box-shadow: var(--elevation-1);
  padding: 24rpx;
  margin-bottom: 24rpx;
  align-items: stretch;
  transition: transform 0.15s ease, box-shadow 0.15s ease;
}
.book-card:active {
  transform: scale(0.98);
  box-shadow: var(--elevation-1);
}

/* 封面图：16:9 比例 */
.book-cover {
  width: 200rpx;
  height: 112rpx;
  border-radius: 12rpx;
  overflow: hidden;
  flex-shrink: 0;
  margin-right: 20rpx;
  background: #F0F6FF;
}
.book-cover-img {
  width: 100%;
  height: 100%;
}
.book-cover-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
}
.cover-placeholder-text {
  font-size: 36rpx;
  font-weight: bold;
  color: var(--primary);
}

/* 文字信息区域 */
.book-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}
.book-title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}
.book-name {
  font-size: 32rpx;
  font-weight: bold;
  color: var(--text-primary);
  flex: 1;
  min-width: 0;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  margin-right: 12rpx;
}
.book-desc {
  font-size: 24rpx;
  color: var(--text-secondary);
  display: -webkit-box;
  overflow: hidden;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  line-height: 1.5;
  margin-bottom: 12rpx;
}

/* 进度区域 */
.book-progress {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
}
.progress-label {
  font-size: 22rpx;
  color: var(--text-secondary);
  margin-right: 12rpx;
  width: 100%;
  margin-bottom: 8rpx;
}
.progress-bar {
  flex: 1;
  height: 12rpx;
  background: #F0F0F0;
  border-radius: 6rpx;
  overflow: hidden;
  margin-right: 12rpx;
}
.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, var(--primary-gradient-start), var(--primary-gradient-end));
  border-radius: 6rpx;
  transition: width 0.4s ease;
}
.progress-percent {
  font-size: 22rpx;
  color: var(--primary);
  font-weight: bold;
  flex-shrink: 0;
  min-width: 44rpx;
  text-align: right;
}

/* ---------- 操作按钮 ---------- */
.book-action {
  flex-shrink: 0;
}
.btn-select {
  height: 52rpx;
  line-height: 52rpx;
  padding: 0 20rpx;
  font-size: 24rpx;
  color: #FFFFFF;
  background: linear-gradient(135deg, var(--primary-gradient-start), var(--primary-gradient-end));
  border-radius: 26rpx;
  border: none;
  font-weight: normal;
}
.btn-select::after {
  border: none;
}
.btn-using {
  height: 52rpx;
  line-height: 52rpx;
  padding: 0 20rpx;
  font-size: 24rpx;
  color: var(--primary);
  background: transparent;
  border-radius: 26rpx;
  border: 2rpx solid var(--primary);
  font-weight: normal;
  opacity: 0.7;
}
.btn-using::after {
  border: none;
}

/* ---------- 加载更多 ---------- */
.load-more {
  text-align: center;
  padding: 32rpx 0 48rpx;
}
.load-more-text {
  font-size: 26rpx;
  color: var(--text-placeholder);
}
.load-more-end {
  color: var(--border-color);
}

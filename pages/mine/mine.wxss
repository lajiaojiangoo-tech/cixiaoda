/* ===== 个人中心页 ===== */

.page-container {
  padding-bottom: 40rpx;
}

/* ===== 顶部用户信息卡 ===== */

.user-card {
  background: linear-gradient(135deg, var(--primary-gradient-start), var(--primary-gradient-end));
  padding: 40rpx 40rpx 48rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
  overflow: hidden;
}
.user-card::before {
  content: '';
  position: absolute;
  top: -80rpx;
  right: -60rpx;
  width: 300rpx;
  height: 300rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.05);
  pointer-events: none;
}
.user-card::after {
  content: '';
  position: absolute;
  bottom: -100rpx;
  left: -80rpx;
  width: 240rpx;
  height: 240rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.04);
  pointer-events: none;
}

.user-avatar-wrap {
  margin-bottom: 16rpx;
}

.avatar-btn {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255, 255, 255, 0.6);
  overflow: hidden;
  padding: 0;
  margin: 0;
  background: transparent;
  line-height: 1;
}

.avatar-btn::after {
  border: none;
}

.avatar-img {
  width: 100%;
  height: 100%;
}

.avatar-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.2);
}

.avatar-placeholder-text {
  font-size: 44rpx;
  font-weight: 700;
  color: #fff;
}

.nickname-input {
  font-size: var(--font-size-title2);
  font-weight: 600;
  color: #fff;
  text-align: center;
  margin-bottom: 24rpx;
  background: transparent;
  border: none;
  padding: 0 20rpx;
  max-width: 70%;
}

.nickname-input::placeholder {
  color: rgba(255, 255, 255, 0.7);
}

.user-stats {
  display: flex;
  align-items: center;
  gap: 0;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 0 48rpx;
}

.stat-number {
  font-size: var(--font-size-title1);
  font-weight: 700;
  color: #fff;
  line-height: 1.2;
}

.stat-label {
  font-size: var(--font-size-small);
  color: rgba(255, 255, 255, 0.8);
  margin-top: 6rpx;
}

.stat-divider {
  width: 2rpx;
  height: 48rpx;
  background: rgba(255, 255, 255, 0.3);
}

/* ===== 通用区块 ===== */

.section {
  padding: 0 40rpx;
  margin-top: 32rpx;
}

.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.section-title {
  font-size: var(--font-size-title2);
  font-weight: 600;
  color: var(--text-primary);
}

/* ===== 设置卡片 ===== */

.settings-card {
  background: var(--card-bg);
  border-radius: var(--radius-card);
  box-shadow: var(--elevation-1);
  overflow: hidden;
}

.setting-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 30rpx;
}

.setting-left {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  flex: 1;
  min-width: 0;
}

.setting-label {
  font-size: var(--font-size-body);
  color: var(--text-primary);
  font-weight: 500;
}

.setting-desc {
  font-size: var(--font-size-small);
  color: var(--text-secondary);
}

.setting-divider {
  height: 1rpx;
  background: var(--border-color);
  margin: 0 30rpx;
}

/* ===== 步进器 ===== */

.stepper {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-shrink: 0;
}

.stepper-btn {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: var(--primary-subtle);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  color: var(--primary);
  font-weight: 600;
  line-height: 1;
  transition: transform 0.15s ease, background 0.15s ease;
}

.stepper-btn:active {
  opacity: 0.7;
  transform: scale(0.92);
}

.stepper-value {
  font-size: var(--font-size-body);
  font-weight: 600;
  color: var(--text-primary);
  min-width: 56rpx;
  text-align: center;
}

/* ===== 开关与选择器 ===== */

.setting-switch {
  flex-shrink: 0;
}

.picker-value {
  font-size: var(--font-size-body);
  color: var(--primary);
  font-weight: 500;
}

/* ===== 菜单项 ===== */

.menu-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 30rpx;
}

.menu-item:active {
  opacity: 0.7;
}

.menu-label {
  font-size: var(--font-size-body);
  color: var(--text-primary);
  font-weight: 500;
}

.menu-right {
  display: flex;
  align-items: center;
}

.menu-arrow {
  font-size: 36rpx;
  color: var(--border-color);
}

/* ===== 关于弹窗 ===== */

.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.4);
  z-index: 100;
}

.modal-content {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 101;
  pointer-events: none;
}
.modal-content .modal-box {
  width: 580rpx;
  background: rgba(255, 255, 255, 0.92);
  backdrop-filter: blur(24rpx);
  -webkit-backdrop-filter: blur(24rpx);
  border-radius: var(--radius-modal);
  padding: 40rpx;
  box-shadow: var(--elevation-5);
  animation: springIn 0.45s ease both;
  pointer-events: auto;
}

.modal-title {
  font-size: var(--font-size-title2);
  font-weight: 600;
  color: var(--text-primary);
  text-align: center;
  display: block;
  margin-bottom: 24rpx;
}

.modal-body {
  margin-bottom: 32rpx;
}

.modal-text {
  font-size: var(--font-size-body);
  color: var(--text-secondary);
  line-height: 1.6;
  display: block;
}

.modal-text.version {
  text-align: center;
  color: var(--text-placeholder);
  margin-top: 16rpx;
  font-size: var(--font-size-caption);
}

.modal-footer {
  display: flex;
  justify-content: center;
}

.modal-btn {
  width: 240rpx;
  height: 80rpx;
  line-height: 80rpx;
  background: linear-gradient(135deg, var(--primary-gradient-start), var(--primary-gradient-end));
  color: #fff;
  font-size: var(--font-size-body);
  font-weight: 600;
  border-radius: var(--radius-button);
  text-align: center;
  margin: 0;
  padding: 0;
  box-shadow: 0 4rpx 16rpx rgba(74, 144, 226, 0.3);
}

.modal-btn::after {
  border: none;
}

.modal-btn:active {
  opacity: 0.85;
}

/* ===== 退出登录 ===== */

.logout-section {
  padding: 60rpx 40rpx 40rpx;
}

.logout-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background: transparent;
  color: var(--danger);
  font-size: var(--font-size-body);
  font-weight: 500;
  border-radius: var(--radius-button);
  border: 2rpx solid var(--accent-red);
  text-align: center;
  margin: 0;
  padding: 0;
}

.logout-btn::after {
  border: none;
}

.logout-btn:active {
  opacity: 0.7;
}

/* ===== 首页样式 ===== */

/* ---------- 页面容器 ---------- */
.page-container {
  padding: 0 40rpx;
}

/* ---------- 加载中（转圈圈） ---------- */
.loading-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-top: 400rpx;
}
.spinner {
  width: 80rpx;
  height: 80rpx;
  border: 6rpx solid #E8EBF0;
  border-top-color: var(--primary);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}
@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}
.loading-text {
  font-size: 28rpx;
  color: var(--text-secondary);
  margin-top: 24rpx;
}

/* ---------- 推荐轮播图 ---------- */
.banner-swiper {
  margin-top: 24rpx;
  height: 170rpx;
  border-radius: var(--radius-card);
  overflow: hidden;
  box-shadow: var(--elevation-1);
}
.banner-slide {
  width: 100%;
  height: 100%;
  border-radius: var(--radius-card);
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 32rpx;
  box-sizing: border-box;
  position: relative;
  overflow: hidden;
}
.banner-slide::before {
  content: '';
  position: absolute;
  right: -40rpx;
  top: -30rpx;
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.5);
  pointer-events: none;
}
.banner-slide::after {
  content: '';
  position: absolute;
  right: 60rpx;
  bottom: -50rpx;
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.35);
  pointer-events: none;
}
.banner-left {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  position: relative;
  z-index: 1;
}
.banner-tag {
  display: inline-block;
  font-size: 20rpx;
  color: var(--primary);
  background: rgba(74, 144, 226, 0.12);
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  align-self: flex-start;
  line-height: 1.6;
  font-weight: 500;
}
.banner-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-primary);
  line-height: 1.3;
}
.banner-desc {
  font-size: 24rpx;
  color: var(--text-secondary);
  line-height: 1.4;
}
.banner-card-preview {
  flex-shrink: 0;
  position: relative;
  z-index: 1;
}
.mini-card {
  width: 100rpx;
  height: 120rpx;
  background: rgba(255,255,255,0.8);
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.06);
}
.mini-word {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--primary);
  line-height: 1.2;
  text-align: center;
}

/* ---------- 空状态（覆盖全局 padding） ---------- */
.empty-state {
  padding-top: 200rpx;
  justify-content: center;
}

/* ---------- 用户区域 ---------- */
.user-section {
  background: linear-gradient(135deg, var(--primary-gradient-start) 0%, var(--primary-gradient-end) 100%);
  margin: 0 -40rpx;
  padding: 40rpx 40rpx 60rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-radius: 0 0 48rpx 48rpx;
  position: relative;
  overflow: hidden;
}
/* 装饰性波纹 */
.user-section::before {
  content: '';
  position: absolute;
  top: -60rpx;
  right: -40rpx;
  width: 280rpx;
  height: 280rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.06);
  pointer-events: none;
}
.user-section::after {
  content: '';
  position: absolute;
  bottom: -80rpx;
  left: -60rpx;
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.04);
  pointer-events: none;
}
.user-info {
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 0;
  position: relative;
  z-index: 1;
}
.user-avatar-wrapper {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  overflow: hidden;
  flex-shrink: 0;
  border: 4rpx solid rgba(255,255,255,0.3);
  background: rgba(255,255,255,0.15);
}
.user-avatar {
  width: 100%;
  height: 100%;
}
.user-avatar-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
}
.avatar-placeholder-text {
  font-size: 40rpx;
  color: #FFFFFF;
  font-weight: bold;
}
.user-text {
  margin-left: 24rpx;
  overflow: hidden;
}
.user-nickname {
  font-size: 36rpx;
  font-weight: bold;
  color: #FFFFFF;
  display: block;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.user-badge {
  font-size: 24rpx;
  color: rgba(255,255,255,0.85);
  margin-top: 8rpx;
  display: block;
}
.today-count {
  text-align: center;
  flex-shrink: 0;
  margin-left: 20rpx;
  position: relative;
  z-index: 1;
}
.today-count-num {
  font-size: 52rpx;
  font-weight: bold;
  color: #FFFFFF;
  display: block;
  line-height: 1;
}
.today-count-label {
  font-size: 22rpx;
  color: rgba(255,255,255,0.8);
  margin-top: 8rpx;
  display: block;
}

/* ---------- 任务卡片 ---------- */
.task-section {
  margin-top: 32rpx;
  position: relative;
  z-index: 1;
}
.task-card {
  background: var(--card-bg);
  border-radius: var(--radius-card);
  box-shadow: var(--elevation-2);
  padding: 32rpx 32rpx;
  margin-bottom: 20rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  position: relative;
  overflow: hidden;
  transition: transform 0.15s ease, box-shadow 0.15s ease;
}
.task-card:active {
  transform: scale(0.98);
  box-shadow: var(--elevation-1);
}
/* 卡片左边装饰色条 */
.task-card::before {
  content: '';
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 6rpx;
  border-radius: 0 3rpx 3rpx 0;
}
.task-card:first-child::before {
  background: linear-gradient(180deg, var(--accent-orange), #FFB340);
}
.task-card:last-child::before {
  background: linear-gradient(180deg, var(--accent-green), #50D974);
}
.task-card-left {
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 0;
}
.task-card-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.task-icon-new {
  background: var(--accent-orange-subtle);
}
.task-icon-review {
  background: var(--accent-green-subtle);
}
.task-icon-text {
  font-size: 32rpx;
}
.task-card-info {
  margin-left: 20rpx;
  overflow: hidden;
}
.task-card-title {
  font-size: 32rpx;
  font-weight: bold;
  color: var(--text-primary);
  display: block;
}
.task-card-desc {
  font-size: 24rpx;
  color: var(--text-secondary);
  margin-top: 6rpx;
  display: block;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.task-card-right {
  text-align: center;
  flex-shrink: 0;
  margin-left: 16rpx;
}
.task-card-count {
  font-size: 44rpx;
  font-weight: bold;
  color: var(--primary);
  display: block;
  line-height: 1;
}
.task-card-unit {
  font-size: 22rpx;
  color: var(--text-secondary);
  margin-top: 4rpx;
  display: block;
}

/* ---------- 切换单词书 ---------- */
.switch-book-bar {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24rpx 0;
  margin-bottom: 8rpx;
}
.switch-book-text {
  font-size: 28rpx;
  color: var(--text-secondary);
  text-decoration: underline;
}
.switch-book-arrow {
  font-size: 28rpx;
  color: var(--text-secondary);
  margin-left: 4rpx;
}

/* ---------- 学习日历 ---------- */
.calendar-card {
  background: var(--card-bg);
  border-radius: var(--radius-card);
  box-shadow: var(--elevation-2);
  padding: 32rpx;
  margin-bottom: 40rpx;
}
.calendar-header-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 28rpx;
}
.calendar-title {
  font-size: 30rpx;
  font-weight: bold;
  color: var(--text-primary);
}
.calendar-nav {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.nav-btn {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  color: var(--primary);
  background: var(--primary-subtle);
  border-radius: 50%;
  line-height: 1;
  transition: transform 0.15s ease;
}
.nav-btn:active {
  transform: scale(0.9);
}
.nav-date {
  font-size: 26rpx;
  color: var(--text-primary);
  font-weight: 600;
  min-width: 120rpx;
  text-align: center;
}
.calendar-weekdays {
  display: flex;
  margin-bottom: 16rpx;
}
.weekday {
  flex: 1;
  text-align: center;
  font-size: 24rpx;
  color: var(--text-secondary);
  font-weight: 500;
  letter-spacing: 2rpx;
}
.weekday.weekend {
  color: var(--accent-red);
}
.calendar-grid {
  display: flex;
  flex-wrap: wrap;
}
.calendar-day {
  width: 14.285%;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 6rpx 0;
  min-height: 72rpx;
}
.day-number {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  color: var(--text-primary);
  border-radius: 50%;
}
.day-number.today {
  background: var(--primary);
  color: #fff;
  font-weight: 600;
  box-shadow: 0 4rpx 12rpx rgba(74, 144, 226, 0.35);
}
.day-number.studied {
  font-weight: 500;
}
.day-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  margin-top: 4rpx;
}
.day-dot.dot-studied {
  background: var(--accent-green);
}



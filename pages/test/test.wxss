/* ===== 测试页样式 ===== */

.page-container {
  padding: 0 40rpx;
  min-height: calc(100vh - 200rpx);
}

/* ===== 进度条（page-specific） ===== */
.progress-index {
  font-size: var(--font-size-caption);
  color: var(--primary);
  font-weight: 600;
}
.progress-type {
  font-size: var(--font-size-small);
  color: var(--text-secondary);
}

/* ===== 题目区域 ===== */
.question-area {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 40rpx;
}

.question-prompt {
  font-size: 44rpx;
  font-weight: 700;
  color: var(--text-primary);
  text-align: center;
  margin-bottom: 12rpx;
}

.question-prompt-spelling {
  font-size: 36rpx;
  margin-bottom: 40rpx;
}

.question-phonetic {
  font-size: 28rpx;
  color: var(--text-secondary);
  margin-bottom: 48rpx;
}

/* ===== 选择题选项 ===== */
.options-list {
  width: 100%;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.option-item {
  width: 100%;
  height: 100rpx;
  background: var(--card-bg);
  border-radius: var(--radius-card);
  box-shadow: var(--elevation-1);
  display: flex;
  align-items: center;
  padding: 0 30rpx;
  box-sizing: border-box;
  transition: border-color 0.2s ease, background-color 0.2s ease, transform 0.15s ease;
  border: 2rpx solid var(--gray-200);
}

.option-item:active {
  transform: scale(0.98);
}

.option-content {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.option-text {
  font-size: var(--font-size-body);
  color: var(--text-primary);
  line-height: 1.4;
  flex: 1;
}

/* 正确选项 */
.option-correct {
  background: var(--accent-green-subtle);
  border-color: var(--accent-green);
}
.option-correct .option-text {
  color: #1B7A34;
}
/* 错误选项 */
.option-wrong {
  background: var(--accent-red-subtle);
  border-color: var(--accent-red);
  animation: shake 0.4s ease;
}
.option-wrong .option-text {
  color: #B71C1C;
}
/* 正确答案提示条 */
.correct-answer-bar {
  margin-top: 32rpx;
  padding: 20rpx 30rpx;
  background: var(--accent-orange-subtle);
  border-radius: var(--radius-input);
  width: 100%;
  box-sizing: border-box;
  text-align: center;
}
.correct-answer-label {
  font-size: var(--font-size-caption);
  color: var(--text-secondary);
}
.correct-answer-text {
  font-size: var(--font-size-body);
  color: var(--primary);
  font-weight: 600;
}

/* ===== 拼写题 ===== */
.spelling-form {
  width: 100%;
  display: flex;
  flex-direction: column;
  gap: 32rpx;
}

.spelling-input {
  width: 100%;
  height: 100rpx;
  background: var(--card-bg);
  border-radius: var(--radius-input);
  padding: 0 30rpx;
  font-size: var(--font-size-body);
  color: var(--text-primary);
  border: 2rpx solid var(--gray-200);
  box-sizing: border-box;
  transition: border-color 0.2s ease, box-shadow 0.2s ease;
}

.spelling-input:focus {
  border-color: var(--primary);
  box-shadow: 0 0 0 4rpx rgba(74, 144, 226, 0.12);
}

.spelling-input.input-correct {
  border-color: var(--accent-green);
  background: var(--accent-green-subtle);
}

.spelling-input.input-wrong {
  border-color: var(--accent-red);
  background: var(--accent-red-subtle);
  animation: shake 0.4s ease;
}

.submit-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  background: linear-gradient(135deg, var(--primary-gradient-start), var(--primary-gradient-end));
  color: #fff;
  font-size: var(--font-size-body);
  font-weight: 600;
  border-radius: var(--radius-button);
  border: none;
  box-shadow: 0 4rpx 16rpx rgba(74, 144, 226, 0.3);
}
.submit-btn::after {
  border: none;
}
.submit-btn[disabled] {
  background: var(--gray-200);
  color: var(--text-placeholder);
  box-shadow: none;
}

.spelling-feedback {
  margin-top: 32rpx;
  width: 100%;
}

.feedback-row {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  padding: 20rpx;
  border-radius: var(--radius-input);
}

.feedback-correct {
  background: var(--accent-green-subtle);
}
.feedback-correct .feedback-text {
  font-size: var(--font-size-body);
  color: #1B7A34;
  font-weight: 600;
}

.feedback-wrong {
  background: var(--accent-red-subtle);
}
.feedback-wrong .feedback-text {
  color: #B71C1C;
}
.feedback-answer {
  font-size: var(--font-size-body);
  color: var(--primary);
  font-weight: 700;
}

/* ===== 结果页 ===== */
.result-page {
  padding-top: 40rpx;
}

.result-hero {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 0;
}

.score-ring-outer {
  width: 240rpx;
  height: 240rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
  box-shadow: 0 0 30rpx rgba(74, 144, 226, 0.15);
}

.score-ring-inner {
  width: 180rpx;
  height: 180rpx;
  border-radius: 50%;
  background: var(--card-bg);
  display: flex;
  align-items: baseline;
  justify-content: center;
  padding: 0 10rpx;
  box-sizing: border-box;
}

.score-number {
  font-size: 64rpx;
  font-weight: 800;
  color: var(--primary);
  line-height: 1;
}

.score-divider {
  font-size: 40rpx;
  color: var(--text-placeholder);
  margin: 0 6rpx;
}

.score-total {
  font-size: 40rpx;
  font-weight: 600;
  color: var(--text-secondary);
  line-height: 1;
}

.result-accuracy {
  font-size: var(--font-size-title2);
  color: var(--text-primary);
  font-weight: 600;
}

/* 对错列表 */
.result-list-section {
  flex: 1;
  display: flex;
  flex-direction: column;
  margin-top: 32rpx;
}

.result-list-title {
  font-size: var(--font-size-caption);
  color: var(--text-secondary);
  margin-bottom: 16rpx;
  font-weight: 600;
}

.result-list {
  flex: 1;
  max-height: 400rpx;
}

.result-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 24rpx;
  background: var(--card-bg);
  border-radius: var(--radius-input);
  margin-bottom: 16rpx;
  box-shadow: var(--elevation-1);
  position: relative;
  overflow: hidden;
}
.result-item::before {
  content: '';
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 4rpx;
}
.item-correct.result-item::before {
  background: var(--accent-green);
}
.item-wrong.result-item::before {
  background: var(--accent-red);
}

.result-item-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex: 1;
  min-width: 0;
}

.result-item-icon {
  font-size: 28rpx;
  font-weight: 700;
  flex-shrink: 0;
}

.item-correct .result-item-icon {
  color: var(--success);
}
.item-wrong .result-item-icon {
  color: var(--danger);
}

.result-item-word-group {
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.result-item-word {
  font-size: var(--font-size-body);
  color: var(--text-primary);
  font-weight: 600;
}

.result-item-meaning {
  font-size: var(--font-size-small);
  color: var(--text-secondary);
  margin-top: 4rpx;
}

.result-item-status {
  font-size: var(--font-size-small);
  flex-shrink: 0;
  margin-left: 12rpx;
}

.item-correct .result-item-status {
  color: var(--accent-green);
}
.item-wrong .result-item-status {
  color: var(--accent-red);
}

.result-item-icon {
  font-size: 28rpx;
  font-weight: 700;
  flex-shrink: 0;
}

.item-correct .result-item-icon {
  color: var(--accent-green);
}
.item-wrong .result-item-icon {
  color: var(--accent-red);
}

/* 结果页按钮 */
.result-actions {
  padding: 32rpx 0 48rpx;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.action-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  border-radius: var(--radius-button);
  font-size: var(--font-size-body);
  font-weight: 600;
  border: none;
}
.action-btn::after {
  border: none;
}
.action-btn:active {
  opacity: 0.85;
  transform: scale(0.98);
}

.action-btn-primary {
  background: linear-gradient(135deg, var(--primary-gradient-start), var(--primary-gradient-end));
  color: #fff;
  box-shadow: 0 4rpx 16rpx rgba(74, 144, 226, 0.3);
}

.action-btn-secondary {
  background: var(--card-bg);
  color: var(--primary);
  border: 2rpx solid var(--primary);
}
.action-btn-secondary:active {
  background: var(--primary-subtle);
}

